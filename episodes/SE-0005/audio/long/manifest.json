  "scenes": [
    {
      "sceneId": "00-context",
      "endingDigest": "e967b488488dbb6a8fd6809a31fb0bd31007ed07dbf0b3b7bd05cf58a46c6644",
      "audioFile": "long/revision-xdf0nM/00-context.mp3",
