  },
  {
    "key": "intro",
    "seconds": 8.34,
    "cues": [
      {
        "text": "1988년 8월 29일, 제록스의 조 베커는 세계 여러 언어의 글자에 공통 번호를 붙이자고 제안했습니다.",
        "startSec": 0.7,
        "endSec": 8.34
      }
    ],
    "digest": "d447cd20024ab7de5f82923376469c4b534e0dfdaed91a4ba404c2e9a6964918",
    "openingLeadIn": true
