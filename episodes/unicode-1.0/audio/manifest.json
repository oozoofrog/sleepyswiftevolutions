  },
  {
    "key": "karen",
    "seconds": 8.09,
    "cues": [
      {
        "text": "베커와 콜린스는 도서관 연구그룹의 캐런 스미스요시무라, 앨런 터커와 만나 어느 한자를 같은 글자로 볼지 논의했습니다.",
        "startSec": 0.05,
        "endSec": 8.09
      }
