    "digest": "ad49dceb87014bd6b2d54933ef56ef0333c0cac86da0ebfb8bbd7a3ee81cb1ba"
  },
  {
    "key": "proposal",
    "seconds": 4.97,
    "cues": [
      {
        "text": "한국 대표단은 여러 나라가 함께 글자를 검토할 연구 그룹을 제안했습니다.",
