  {
    "key": "cjk",
    "seconds": 8.56,
    "cues": [
      {
        "text": "1988년 7월, 애플은 한자 통합을 연구하려고 이 단체의 한·중·일 문자 데이터베이스를 구입했습니다.",
        "startSec": 0.05,
        "endSec": 8.56
      }
    ],
    "digest": "ebc0988b47dbeb187c01e7ccf8f16fc0dec84d9076fea80c09164da5883e555d"
  },
  {
    "key": "network",
    "seconds": 6.79,
    "cues": [
      {
        "text": "참여자가 늘자 회의실 밖에서도 토론이 이어졌습니다.",
        "startSec": 0.05,
        "endSec": 3.28
      },
      {
        "text": "글렌 라이트가 전자우편 토론을 맡았습니다.",
        "startSec": 3.87,
        "endSec": 6.79
      }
