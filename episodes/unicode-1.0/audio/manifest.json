  },
  {
    "key": "davis",
    "seconds": 5.03,
    "cues": [
      {
        "text": "애플의 마크 데이비스는 기종이 달라도 같은 문서를 읽을 방법을 고민했습니다.",
        "startSec": 0.05,
        "endSec": 5.03
      }
