    "digest": "4839bc4e067edd7ca5afac0ac66d958d3f2c76fdd4a9362612f2c94686e808fa"
  },
  {
    "key": "library",
    "seconds": 8.11,
    "cues": [
      {
        "text": "도서관에서는 사서가 한국어나 중국어, 일본어로 책 제목을 입력하면 다른 도서관도 그 기록을 쓸 수 있었습니다.",
        "startSec": 0.05,
        "endSec": 8.11
