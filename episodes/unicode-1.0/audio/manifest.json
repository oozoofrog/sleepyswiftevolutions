    "digest": "90326fd58c24df5b320033328fcdf1b3c22e1ece0483d5dd4ac85e557e0f8bb6"
  },
  {
    "key": "travel",
    "seconds": 4.52,
    "cues": [
      {
        "text": "이 글자를 따라, 제안서가 쓰이기 전의 제록스로 돌아가 보겠습니다.",
