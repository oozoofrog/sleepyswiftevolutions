      "endSec": 23.225,
      "cues": [
        {
          "startSec": 12.625,
          "endSec": 17.215,
          "text": "먼저 넷을 저장하고 나서 원래 변수의 값을 다섯으로 올립니다."
        },
        {
          "startSec": 17.805,
          "endSec": 22.325,
