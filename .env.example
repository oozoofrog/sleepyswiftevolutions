# ==============================================================================
# Swift Evolution YouTube Pipeline Configuration
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# --- TTS (Narration Voice) ---
# qwen3-clone (로컬 내 목소리 복제 기본) | qwen3-tts | edge | macos-say | openai | elevenlabs | custom | auto
TTS_PROVIDER=qwen3-clone

# 로컬 MLX Qwen3-TTS & ForcedAligner 설정 (/Volumes/eyedisk/AI)
MLX_AUDIO_PYTHON=/Volumes/eyedisk/AI/Environments/mlx-audio-py312/bin/python
QWEN3_TTS_BASE_MODEL=/Volumes/eyedisk/AI/Models/MLX-Audio/Qwen3-TTS-12Hz-1.7B-Base-8bit
QWEN3_TTS_CUSTOM_MODEL=/Volumes/eyedisk/AI/Models/MLX-Audio/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
QWEN3_TTS_DESIGN_MODEL=/Volumes/eyedisk/AI/Models/MLX-Audio/Qwen3-TTS-12Hz-1.7B-VoiceDesign-8bit
QWEN3_ALIGNER_MODEL=/Volumes/eyedisk/AI/Models/MLX-Audio/Qwen3-ForcedAligner-0.6B-8bit
QWEN3_ASR_BIN=/Volumes/eyedisk/AI/bin/qwen3-asr
QWEN3_TTS_VOICE=Sohee
QWEN3_TTS_INSTRUCT=
QWEN3_TTS_TEMPERATURE=0.7
QWEN3_TTS_USE_ALIGNER=true

# 내 목소리 참조 프로필 경로 (pnpm evo voice-profile set/record 로 등록)
VOICE_PROFILE_DIR=secrets/voice-profile
# 선택: 외부 경로의 참조 음성과 전사 텍스트를 직접 지정할 경우 사용
VOICE_PROFILE_AUDIO=
VOICE_PROFILE_TEXT=

# Edge TTS (네트워크 폴백 또는 --tts edge 선택 시)
# Korean Edge TTS voices: ko-KR-HyunsuMultilingualNeural, ko-KR-InJoonNeural, ko-KR-SunHiNeural
EDGE_TTS_VOICE=ko-KR-HyunsuMultilingualNeural
EDGE_TTS_RATE=+5%
EDGE_TTS_FALLBACK_MACOS=true

# macOS `say` fallback / local preview settings
MACOS_SAY_VOICE=Yuna
MACOS_SAY_RATE=185

# OpenAI TTS (optional, used when TTS_PROVIDER=openai)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# ElevenLabs TTS (optional, used when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- LLM Script Generation (optional: you can also author script.json via AI coding agent or manually) ---
# auto | openai | anthropic | gemini
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Remotion Rendering ---
REMOTION_CONCURRENCY=4
# Optional explicit browser binary path if headless shell is unavailable
# REMOTION_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
REMOTION_BROWSER_EXECUTABLE=

# --- YouTube Data API v3 Upload ---
YOUTUBE_CLIENT_SECRET_PATH=secrets/youtube-client-secret.json
YOUTUBE_TOKEN_PATH=secrets/youtube-token.json
# private | unlisted | public
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_DEFAULT_PLAYLIST_LONG=Swift Evolution 처음부터 끝까지
YOUTUBE_DEFAULT_PLAYLIST_SHORT=Swift Evolution Shorts
YOUTUBE_OAUTH_PORT=43821
